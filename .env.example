# RusGo — Supabase env namunasi
# Bu faylni `.env.local` ga ko'chiring va qiymatlarni to'ldiring:
#   cp .env.example .env.local
# Qiymatlarni Supabase dashboard → Project Settings → API dan oling.
#
# Agar bu qiymatlar bo'sh bo'lsa, ilova avtomatik DEMO rejimida ishlaydi
# (hech qanday sozlash shart emas).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Faqat server tomonida ishlatiladi — brauzerga hech qachon uzatilmaydi.
SUPABASE_SERVICE_ROLE_KEY=
